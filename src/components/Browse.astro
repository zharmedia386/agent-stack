---
interface Chip {
  key: string;
  label: string;
  emoji?: string;
  count: number;
  section?: string;
}

interface Props {
  chips: Chip[];
  kind: 'cat' | 'group';
  total: number;
  placeholder: string;
  back?: { href: string; label: string };
}

const { chips, kind, total, placeholder, back } = Astro.props;
const sections = [...new Set(chips.map((chip) => chip.section ?? ''))];
const allLabel = kind === 'cat' ? 'All lists' : 'All groups';
---

<div class="browse container">
  <aside class="side">
    <details class="side__panel" open data-side-panel>
      <summary class="side__summary">
        <span class="mono-label">{kind === 'cat' ? 'List' : 'Group'}</span>
        <span class="side__current" data-current>{allLabel}</span>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m6 9 6 6 6-6"></path></svg>
      </summary>
      <script is:inline>
        // Start collapsed on small screens before first paint; desktop keeps the list open.
        if (!matchMedia('(min-width: 1200px)').matches) document.currentScript.parentElement.open = false;
      </script>
      <nav class="side__nav" aria-label={kind === 'cat' ? 'Filter by list' : 'Filter by group'}>
        {back && <a class="side__back" href={back.href}>{back.label}</a>}
        <button type="button" class="opt" data-chip="all" data-chip-kind={kind} data-label={allLabel} aria-pressed="true">
          <span>{allLabel}</span>
          <span class="opt__count" data-count>{total}</span>
        </button>
        {
          sections.map((section) => (
            <div class="side__group">
              {section && <p class="side__section mono-label">{section}</p>}
              {chips
                .filter((chip) => (chip.section ?? '') === section)
                .map((chip) => (
                  <button type="button" class="opt" data-chip={chip.key} data-chip-kind={kind} data-label={chip.emoji ? `${chip.emoji} ${chip.label}` : chip.label} aria-pressed="false">
                    <span class="opt__label">
                      {chip.emoji && <span aria-hidden="true">{chip.emoji}</span>}
                      <span>{chip.label}</span>
                    </span>
                    <span class="opt__count" data-count>{chip.count}</span>
                  </button>
                ))}
            </div>
          ))
        }
      </nav>
    </details>
  </aside>

  <div class="main">
    <div class="bar">
      <label class="search">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span class="visually-hidden">Search repos</span>
        <input id="q" type="search" placeholder={placeholder} autocomplete="off" spellcheck="false" />
      </label>
      <slot name="bar" />
    </div>
    <slot />
  </div>
</div>

<style>
  .browse {
    --summary-h: 56px;
    display: flex;
    flex-direction: column;
  }

  .side {
    position: sticky;
    top: 0;
    z-index: 21;
    background: hsl(var(--background));
  }

  .side__summary {
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--summary-h);
    padding: 0 4px;
    border-bottom: 1px solid hsl(var(--border));
    cursor: pointer;
    list-style: none;
    font: 400 15px/1 var(--font-display);
  }

  .side__summary::-webkit-details-marker {
    display: none;
  }

  .side__current {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .side__panel[open] .side__summary svg {
    transform: rotate(180deg);
  }

  .side__nav {
    display: grid;
    gap: 2px;
    max-height: 60vh;
    overflow-y: auto;
    padding: 10px 0 14px;
    border-bottom: 1px solid hsl(var(--border));
  }

  .side__group {
    display: grid;
    gap: 2px;
  }

  .side__section {
    margin: 16px 12px 6px;
    font-size: 11px;
  }

  .side__back {
    margin: 0 12px 10px;
    font: 400 14px/20px var(--font-display);
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }

  .side__back:hover {
    color: hsl(var(--foreground));
  }

  .opt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 40px;
    padding: 8px 12px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: hsl(var(--foreground));
    font: 400 15px/20px var(--font-display);
    text-align: left;
    cursor: pointer;
    transition: background-color 140ms var(--ease-out);
  }

  .opt:hover {
    background: hsl(var(--muted));
  }

  .opt[aria-pressed='true'] {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  .opt__label {
    display: flex;
    gap: 10px;
    min-width: 0;
  }

  .opt__count {
    flex-shrink: 0;
    font: 400 12px/1 var(--font-mono);
    opacity: 0.6;
  }

  .main {
    min-width: 0;
  }

  .bar {
    position: sticky;
    top: var(--summary-h);
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 0;
    background: hsl(var(--background));
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    border: 1px solid hsl(var(--border));
    background: hsl(var(--surface));
    color: hsl(var(--muted-foreground));
  }

  .search:focus-within {
    border-color: hsl(var(--ring));
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: hsl(var(--foreground));
    font: 400 16px/1 var(--font-body);
  }

  @media (min-width: 1200px) {
    .browse {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 32px;
      align-items: start;
      padding-top: 16px;
    }

    .side {
      top: 16px;
      max-height: calc(100vh - 32px);
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .side__summary {
      display: none;
    }

    .side__nav {
      max-height: none;
      overflow: visible;
      padding-top: 0;
      border-bottom: 0;
    }

    .bar {
      top: 0;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
