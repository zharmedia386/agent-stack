---
import { Code } from 'astro:components';
import type { CodeLanguage } from 'astro';

interface Props {
  code: string;
  lang: string;
}

const { code, lang } = Astro.props;
---

<div class="codeblock">
  <div class="codeblock__bar">
    <span class="mono-label">{lang}</span>
    <button type="button" class="codeblock__copy" data-copy={code}>
      <span aria-live="polite">Copy</span>
    </button>
  </div>
  <Code code={code} lang={lang as CodeLanguage} themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} wrap={false} />
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector('span');
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Press ⌘C';
      }
      setTimeout(() => label && (label.textContent = 'Copy'), 1500);
    });
  });
</script>

<style>
  .codeblock {
    border: 1px solid hsl(var(--border));
    border-radius: 14px;
    background: hsl(var(--code-bg));
    overflow: hidden;
  }

  .codeblock__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px 6px 16px;
    border-bottom: 1px solid hsl(var(--border));
  }

  .codeblock__copy {
    min-height: 32px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    border: 1px solid hsl(var(--border));
    background: hsl(var(--surface));
    color: hsl(var(--foreground));
    font: 400 13px/1 var(--font-display);
    cursor: pointer;
  }

  .codeblock :global(pre) {
    margin: 0;
    padding: 16px;
    overflow-x: auto;
    background: transparent !important;
    font: 400 13.5px/1.6 var(--font-mono);
  }

  .codeblock :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  .codeblock :global(pre span) {
    color: var(--shiki-light);
  }

  :global(:root[data-theme='dark']) .codeblock :global(pre span) {
    color: var(--shiki-dark);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .codeblock :global(pre span) {
      color: var(--shiki-dark);
    }
  }
</style>
