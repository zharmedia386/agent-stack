---
interface Props {
  value: string;
}

const { value } = Astro.props;
const chars = [...value];
let digitIndex = 0;
---

<span class="odo" aria-label={value}>
  {
    chars.map((char) =>
      /\d/.test(char) ? (
        <span class="odo__col" aria-hidden="true" style={`--d:${char};--k:${digitIndex++}`}>
          <span class="odo__reel">
            {Array.from({ length: 10 }, (_, digit) => (
              <span>{digit}</span>
            ))}
          </span>
        </span>
      ) : (
        <span aria-hidden="true">{char}</span>
      ),
    )
  }
</span>

<style>
  .odo {
    display: inline-flex;
    font-variant-numeric: tabular-nums;
  }

  .odo__col {
    display: inline-block;
    height: 1.1em;
    overflow: hidden;
  }

  .odo__reel {
    display: flex;
    flex-direction: column;
    line-height: 1.1em;
    transform: translateY(calc(var(--d) * -1.1em));
  }

  :global(.js) .odo:not(.is-in) .odo__reel {
    transform: translateY(0);
  }

  :global(.js) .odo .odo__reel {
    transition: transform 1400ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(300ms + var(--k) * 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .odo .odo__reel {
      transition: none;
    }

    :global(.js) .odo:not(.is-in) .odo__reel {
      transform: translateY(calc(var(--d) * -1.1em));
    }
  }
</style>
