---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Browse from '../components/Browse.astro';
import Card from '../components/Card.astro';
import Corridor from '../components/Corridor.astro';
import Marquee from '../components/Marquee.astro';
import Odometer from '../components/Odometer.astro';
import SplitWords from '../components/SplitWords.astro';
import { stars } from '../data/stars.ts';
import { formatStars } from '../lib/format.ts';

const { repos, categories, generatedAt } = stars;
const lists = categories.filter((category) => category.slug !== 'recently-starred').length;
const top = repos.reduce((best, repo) => (repo.stars > best.stars ? repo : best));
const newest = repos.reduce((latest, repo) => (repo.starredAt > latest.starredAt ? repo : latest));
const updated = new Date(generatedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const corridorRepos = [...repos].sort((a, b) => b.stars - a.stars).slice(0, 8);
const subtitle = `${repos.length} agent skills, MCP servers & open-source tools, hand-picked and annotated by zharmedia386`;
const chips = categories.map((category) => ({
  key: category.slug,
  label: category.title,
  emoji: category.emoji,
  count: category.count,
  section: category.section,
}));
---

<Base title="The Agent Stack · Agent Skills, MCP Servers & Open-Source Tools" description={subtitle}>
  <p class="announce">
    <span>{repos.length} repos</span><span aria-hidden="true">·</span><span>{lists} lists</span><span aria-hidden="true">·</span><span class="announce__muted">updated {updated}</span>
  </p>
  <Hero>
    <Corridor slot="art" repos={corridorRepos} />
    <p class="live" data-in data-pause-offscreen style="--in:0">
      <span class="live__dot" aria-hidden="true"></span>
      {repos.length} stars · synced daily · {updated}
    </p>
    <h1 class="title split"><SplitWords text="The Agent Stack" /></h1>
    <p class="subtitle" data-in style="--in:3">
      {repos.length} agent skills, MCP servers &amp; open-source tools, hand-picked and annotated by{' '}
      <a href="https://github.com/zharmedia386" rel="noopener">zharmedia386</a>
    </p>
    <div class="actions" data-in style="--in:4">
      <a class="pill pill--light" href="#browse">Browse all {repos.length}</a>
      <a class="pill pill--glass" href="https://github.com/zharmedia386?tab=stars" rel="noopener">Starred on GitHub ↗</a>
    </div>
    <dl class="stats" slot="foot" data-in style="--in:5">
      <div><dt><Odometer value={String(repos.length)} /></dt><dd>Starred repos</dd></div>
      <div><dt><Odometer value={String(lists)} /></dt><dd>Curated lists</dd></div>
      <div>
        <dt>★ <Odometer value={formatStars(top.stars)} /></dt>
        <dd>Most starred · <a href={`/r/${top.slug}/`}>{top.name}</a></dd>
      </div>
      <div>
        <dt>New</dt>
        <dd>Latest star · <a href={`/r/${newest.slug}/`}>{newest.name}</a></dd>
      </div>
    </dl>
  </Hero>

  <Marquee categories={categories} />

  <section id="browse" aria-label="Browse repos">
    <Browse chips={chips} kind="cat" total={repos.length} placeholder={`Search ${repos.length} repos…`}>
      <a slot="bar" class="open-list" data-open-list hidden href="/">Open list →</a>
      <div class="results reveal">
        <div class="grid">
          {repos.map((repo) => <Card repo={repo} categories={categories} />)}
        </div>
        <div id="empty" class="empty" hidden>
          <p>No repos match.</p>
          <button type="button" id="clear-filters" class="pill pill--outline">Clear search</button>
        </div>
      </div>
    </Browse>
  </section>
</Base>

<script>
  import '../scripts/browse.ts';
</script>

<style>
  .announce {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0;
    padding: 14px 16px 2px;
    font: 400 14px/20px var(--font-display);
  }

  .announce__muted {
    color: hsl(var(--muted-foreground));
  }

  .live {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    margin: 0 0 22px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--glass-10);
    border: 1px solid var(--glass-24);
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .live__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22a05c;
  }

  /* Pulse with transform/opacity so it stays on the compositor (box-shadow repaints every frame). */
  .live__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22a05c;
    animation: live-dot 2.4s ease-out infinite;
  }

  @keyframes live-dot {
    from {
      opacity: 0.6;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  .live.is-off .live__dot::after {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .live__dot::after {
      animation: none;
    }
  }

  .title {
    --split-delay: 220ms;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: -0.025em;
    max-width: 12ch;
  }

  .subtitle {
    margin: 18px 0 0;
    max-width: 46ch;
    font: 400 clamp(16px, 1.6vw, 18px) / 1.45 var(--font-display);
    color: var(--glass-92);
  }

  .subtitle a {
    color: #fff;
    text-underline-offset: 3px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 40px;
    margin: 0;
  }

  .stats div {
    min-width: 0;
  }

  .stats dt {
    font: 400 22px/1.1 var(--font-display);
  }

  .stats dd {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--glass-78);
  }

  .stats a {
    color: #fff;
  }

  .open-list {
    align-self: flex-start;
    font: 400 14px/1 var(--font-display);
    color: hsl(var(--muted-foreground));
  }

  .open-list[hidden] {
    display: none;
  }
</style>
